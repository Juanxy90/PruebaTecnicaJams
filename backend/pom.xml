<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM agregador: permite compilar y probar todos los microservicios con un solo comando
  (mvn clean verify desde /backend). Cada microservicio es independiente (no hereda de aquí)
  y se construye por separado en su propia imagen Docker.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ufinet.autos</groupId>
    <artifactId>ufinet-autos-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ufinet-autos-backend</name>

    <modules>
        <module>auth-service</module>
        <module>car-service</module>
        <module>api-gateway</module>
    </modules>
</project>
