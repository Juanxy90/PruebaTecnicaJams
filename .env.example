# Copie este archivo como ".env" (en la misma carpeta de docker-compose.yml) para
# sobrescribir los valores por defecto. NUNCA suba el .env real al repositorio.

# Contraseña del usuario "sa" de SQL Server.
# Requisitos de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Ufinet#2026Strong

# Puerto local para conectarse a SQL Server (SSMS / Azure Data Studio)
SQLSERVER_PORT=1433

# Clave HMAC del JWT en Base64 (mínimo 256 bits). Genere una nueva con:
#   openssl rand -base64 64
# PowerShell:
#   $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_SECRET=3AumwJ9Q1DMui4BH/cavAZDGdVQQ5uoPPY0fbE6lQZPxgii5rbRMCaw01Ormv72AkFHHktAQuuFYbGYik5LJXg==

# Vigencia del token en minutos
JWT_EXPIRATION_MINUTES=60
